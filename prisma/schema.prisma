generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Match {
  id        Int         @id @default(autoincrement())
  homeTeam  String
  awayTeam  String
  sport     String
  startTime DateTime
  endTime   DateTime
  status    MatchStatus @default(SCHEDULED)
  homeScore Int         @default(0)
  awayScore Int         @default(0)

  commentary Commentary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commentary {
  id Int @id @default(autoincrement())

  matchId    Int
  actor      String
  message    String
  minute     Int?
  sequenceNo Int

  details Json?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([matchId, sequenceNo])
}
